+/******************************************************************************************/
+/******************************************************************************************/
+/**                                                                                       */
+/**  TX_BLOCK_POOL  *_tx_misra_void_to_block_pool_pointer_convert(VOID *pointer);         */
+/**                                                                                       */
+/******************************************************************************************/
+/******************************************************************************************/
+TX_BLOCK_POOL  *_tx_misra_void_to_block_pool_pointer_convert(VOID *pointer)
+{
+
+    /* Return a block pool pointer.  */
+    return((TX_BLOCK_POOL *) ((VOID *) pointer));
