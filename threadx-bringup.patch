+/**************************************************************************/
+UINT  _txe_byte_pool_prioritize(TX_BYTE_POOL *pool_ptr)
+{
+
+UINT        status;
+
+
+    /* Check for an invalid byte memory pool pointer.  */
+    if (pool_ptr == TX_NULL)
