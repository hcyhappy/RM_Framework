diff --git a/board/Middlewares/ThreadX/common/src/txe_byte_allocate.c b/board/Middlewares/ThreadX/common/src/txe_byte_allocate.c
new file mode 100644
index 0000000..dbb3937
--- /dev/null
+++ b/board/Middlewares/ThreadX/common/src/txe_byte_allocate.c
@@ -0,0 +1,200 @@
+/***************************************************************************
