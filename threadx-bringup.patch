+#else   /* TX_MISRA_ENABLE is defined, use MISRA function. */
+ULONG   _tx_misra_ipsr_get(VOID);
+#define TX_THREAD_GET_SYSTEM_STATE()        (_tx_thread_system_state | _tx_misra_ipsr_get())
+#endif  /* TX_MISRA_ENABLE */
