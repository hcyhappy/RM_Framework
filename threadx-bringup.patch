+/**************************************************************************/
+/**************************************************************************/
+/**                                                                       */
+/**  VOID  _tx_misra_message_copy(ULONG **source, ULONG **destination,    */
+/**                                                           UINT size); */
+/**                                                                       */
+/**************************************************************************/
+/**************************************************************************/
+VOID  _tx_misra_message_copy(ULONG **source, ULONG **destination, UINT size)
+{
+
+ULONG   *s, *d;
+UINT    z;
+
+    s =  *source;
+    d =  *destination;
+    z =  size;
+
+    *(d) = *(s);
+    (d)++;
+    (s)++;
+    if ((z) > ((UINT) 1))
+    {
+        (z)--;
+        while ((z))
+        {
+            *(d) =  *(s);
+            (d)++;
+            (s)++;
+            (z)--;
+        }
+    }
+
+    *source = s;
+    *destination = d;
+}
+
+
