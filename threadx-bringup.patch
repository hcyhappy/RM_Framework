+/*                                                                        */
+/**************************************************************************/
+// UINT   _tx_thread_interrupt_disable(VOID)
+// {
+    .global  _tx_thread_interrupt_disable
+    .thumb_func
+_tx_thread_interrupt_disable:
+    /* Return current interrupt lockout posture.  */
+#ifdef TX_PORT_USE_BASEPRI
+    MRS     r0, BASEPRI
+    LDR     r1, =TX_PORT_BASEPRI
+    MSR     BASEPRI, r1
+#else
+    MRS     r0, PRIMASK
+    CPSID   i
+#endif
+    BX      lr
+// }
