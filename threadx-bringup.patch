+/* Define the block memory pool structure utilized by the application.  */
+
+typedef struct TX_BLOCK_POOL_STRUCT
+{
+
+    /* Define the block pool ID used for error checking.  */
+    ULONG               tx_block_pool_id;
+
+    /* Define the block pool's name.  */
