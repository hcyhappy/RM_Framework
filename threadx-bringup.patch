+    if (status == TX_SUCCESS)
+    {
+
+        /* Call actual queue front send function.  */
+        status =  _tx_queue_front_send(queue_ptr, source_ptr, wait_option);
+    }
+
+    /* Return completion status.  */
+    return(status);
+}
