+/***********************************************************************************/
+/***********************************************************************************/
+/**                                                                                */
+/**  UCHAR  *_tx_misra_block_pool_to_uchar_pointer_convert(TX_BLOCK_POOL *pool);   */
+/**                                                                                */
+/***********************************************************************************/
+/***********************************************************************************/
+UCHAR  *_tx_misra_block_pool_to_uchar_pointer_convert(TX_BLOCK_POOL *pool)
+{
+
+    /* Return a UCHAR pointer.  */
+    return((UCHAR *) ((VOID *) pool));
