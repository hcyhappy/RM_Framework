+    rx_result=HAL_OK; assert(USART_Service(&huart1)==HAL_OK && huart1.RxState==HAL_UART_STATE_BUSY_RX);
+    assert(USART_Transmit(&huart1,data,3,USART_MODE_DMA)==HAL_OK);
