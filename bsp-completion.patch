+    {
+        BspCritical lock;
+        if (!port || !port->initialized || !hardware_ready(huart)) return HAL_ERROR;
+        port->receiving = false;
+    }
+    HAL_StatusTypeDef status = HAL_UART_AbortReceive(huart);
+    {
+        BspCritical lock;
+        port->stats.receive_status = status;
+    }
+    return status;
