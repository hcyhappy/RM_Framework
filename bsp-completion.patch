+HAL_StatusTypeDef initialize(CAN_HandleTypeDef *hcan, uint32_t bank) {
+    Bus *bus = bus_for(hcan);
+    if (!bus || !clock_enabled(hcan) ||
+        !NVIC_GetEnableIRQ(hcan == &hcan1 ? CAN1_RX0_IRQn : CAN2_RX0_IRQn)) return HAL_ERROR;
