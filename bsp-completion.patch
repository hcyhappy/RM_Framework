+    if (__get_IPSR() || __get_PRIMASK()) return HAL_ERROR;
+    Port *port = port_for(huart);
+    bool abort_tx;
+    {
+        BspCritical lock;
+        if (!port || !port->initialized || !hardware_ready(huart)) return HAL_ERROR;
+        abort_tx = port->tx_needs_abort;
+    }
