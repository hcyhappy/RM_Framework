+    assert(USART_Transmit(&huart1,data,1,static_cast<USART_Mode>(8))==HAL_ERROR);
+    tx_result=HAL_ERROR; assert(USART_Transmit(&huart1,data,3,USART_MODE_DMA)==HAL_ERROR);
+    tx_result=HAL_OK;
