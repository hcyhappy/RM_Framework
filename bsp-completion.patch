+        if (!port || !port->initialized || !hardware_ready(huart)) return HAL_ERROR;
+        if (port->tx_busy || huart->gState != HAL_UART_STATE_READY) return HAL_BUSY;
+        if (mode != USART_MODE_BLOCK &&
