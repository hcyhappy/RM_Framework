diff --git a/threads/src/controlthread.cpp b/threads/src/controlthread.cpp
new file mode 100644
index 0000000..12c7e65
--- /dev/null
+++ b/threads/src/controlthread.cpp
@@ -0,0 +1,103 @@
+#include "threads_internal.hpp"
+#include "app_config.hpp"
+#include "M2006.hpp"
+#include "DJIMotorHandler.hpp"
+#include "bsp_usart.hpp"
+namespace {
+void relax(M2006 &motor) {
+    motor.controlMode=DJIMotor::RELAX_MODE; motor.currentSet=0;
+    motor.speedPid.Clear(); motor.positionPid.Clear();
+}
+}
+void control_thread_entry(ULONG) {
+    // Static lifetime because the registry keeps pointers; never expose motor to another thread.
+    static M2006 motor;
+    auto *handler=DJIMotorHandler::Instance();
+    auto *bus=AppConfig::MotorCanBus==2 ? &hcan2 : &hcan1;
+    const bool registered=(AppConfig::MotorCanBus==1 || AppConfig::MotorCanBus==2) &&
+                           handler->registerMotor(&motor,bus,AppConfig::MotorFeedbackId);
+    motor.maxCurrent=AppConfig::CurrentLimit;
+    motor.offlineTimeoutMs=AppConfig::MotorFeedbackTimeoutMs;
+    motor.speedPid=PID(AppConfig::SpeedKp,AppConfig::SpeedKi,AppConfig::SpeedKd,
+                       AppConfig::CurrentLimit,AppConfig::SpeedIntegralLimit);
+    motor.positionPid=PID(AppConfig::PositionKp,AppConfig::PositionKi,AppConfig::PositionKd,
+                          AppConfig::MaxSpeed,AppConfig::PositionIntegralLimit);
+    { AppLock lock; app_health.controlInit=registered ? InitState::Ready : InitState::Failed; }
+    AppInitChanged();
+    ULONG deadline=tx_time_get(), lastLoop=deadline;
+    uint32_t generation=0;
+    bool fault=false;
+#if RM_ENABLE_MOTOR_OUTPUT
+    bool transmitted=false, abortNeeded=false, stopPending=false;
+    unsigned sendFailures=0, abortFailures=0;
+#endif
+    for (;;) {
+        const ULONG now=tx_time_get();
+        const bool late=ULONG(now-lastLoop)>AppTicks(10);
+        lastLoop=now;
+        handler->PollFeedback(); // ONE consumer for both buses, unhandledFrame can dispatch other protocols
+        const bool online=registered && motor.AliveCheck()==DJIMotor::MOTOR_ONLINE;
+        ControlCommand command;
+        { AppLock lock; command=app_control_command; }
+        ControlState state=ControlState::Disabled;
+#if RM_ENABLE_MOTOR_OUTPUT
+        const bool newArm=command.enabled && generation!=command.armGeneration;
+        if (newArm) {
+            generation=command.armGeneration;
+            fault=!registered || !MotorConfigValid() || !online || !motor.ZeroPosition();
+            sendFailures=abortFailures=0;
+            abortNeeded=true; // remove old pending commands before this new session
+        }
+        if (!command.enabled) { fault=false; relax(motor); }
+        else if (late || !online || !motor.positionValid || !MotorConfigValid()) fault=true;
+        if (command.enabled && !fault) {
+            motor.positionSet=command.positionRad;
+            motor.controlMode=DJIMotor::POS_MODE;
+            motor.setOutput(); // outer position -> bounded speed -> inner speed -> bounded current
+            state=ControlState::Running;
+        } else {
+            relax(motor);
+            state=command.enabled ? ControlState::Fault : ControlState::Disabled;
+            if (transmitted) { abortNeeded=true; stopPending=true; }
+        }
+        if (abortNeeded) {
+            const auto result=CAN_AbortPending(bus);
+            if (result==HAL_OK) { abortNeeded=false; transmitted=false; abortFailures=0; }
+            // No new nonzero frame until hardware has confirmed pending mailboxes are clear.
+            else {
+                { AppLock lock; ++app_health.canSendErrors; }
+                if (result!=HAL_BUSY || ++abortFailures>=5) fault=command.enabled;
+            }
+        }
+        if (registered && !abortNeeded && (command.enabled || stopPending)) {
+            if (fault) relax(motor);
+            const auto result=handler->sendControlData();
+            transmitted=command.enabled;
+            if (result!=HAL_OK) {
+                { AppLock lock; ++app_health.canSendErrors; }
+                if (result!=HAL_BUSY || ++sendFailures>=5) {
+                    fault=command.enabled; abortNeeded=true; relax(motor);
+                }
+            } else { sendFailures=0; stopPending=false; }
+        }
+        if (fault && command.enabled) { state=ControlState::Fault; relax(motor); }
+#else
+        (void)generation; (void)late; (void)fault;
+        relax(motor); // receive/monitor only: no CAN control transmission in default build
+#endif
+        // RX error recovery stays at BSP layer, no printf/DMA TX or blocking UART sends here.
+        (void)USART_Service(&huart1);
+        (void)USART_Service(&huart6);
+        { AppLock lock;
+          app_health.control=(!registered) ? ControlState::Fault :
+                            (!command.enabled && !online ? ControlState::AwaitFeedback : state);
+          app_health.motorOnline=online;
+          app_health.motorPosition=motor.motorFeedback.positionFdb;
+          app_health.motorSpeed=motor.motorFeedback.speedFdb;
+          app_health.targetPosition=command.positionRad;
+          app_health.currentCommand=motor.currentSet;
+        }
+        AppPulse(TaskId::Control);
+        AppSleepUntil(deadline,AppTicks(AppConfig::ControlPeriodMs));
+    }
+}
diff --git a/threads/src/imuthread.cpp b/threads/src/imuthread.cpp
new file mode 100644
index 0000000..db9492f
--- /dev/null
+++ b/threads/src/imuthread.cpp
@@ -0,0 +1,103 @@
+#include "threads_internal.hpp"
+#include "app_config.hpp"
+#include "BMI088.hpp"
+#include "bsp_time.hpp"
+namespace {
+void setInit(InitState state) {
+    { AppLock lock; app_health.imuInit=state; app_health.imuDataOk=false;
+      app_imu.valid=false; app_imu.attitudeValid=false; app_imu.temperatureValid=false; }
+    AppInitChanged();
+}
+}
+void imu_thread_entry(ULONG) {
+    BMI088::cBMI088 bmi;
+#if RM_ENABLE_AHRS6
+    Ahrs6 ahrs;
+    uint32_t previous=0;
+    bool previousValid=false;
+#endif
+    ImuSnapshot data;
+    bool ready=false;
+    uint32_t retry=0, temp=0;
+    bool firstAttempt=true, firstTemperature=true;
+    float cachedTemperature=0;
+    unsigned failures=0;
+#if RM_ENABLE_IST8310
+    IST8310 mag;
+    bool magReady=false, firstMag=true;
+    uint32_t magRetry=0, magPoll=0;
+#endif
+    ULONG deadline=tx_time_get();
+    for (;;) {
+        uint32_t now=BSP_GetTickMs();
+        if (!ready && (firstAttempt || uint32_t(now-retry)>=AppConfig::InitRetryMs)) {
+            firstAttempt=false;
+            setInit(InitState::Pending);
+            bmi.Config(); // bounded driver delays use ThreadX sleep
+            ready=bmi.Ready(); retry=BSP_GetTickMs();
+            setInit(ready ? InitState::Ready : InitState::Failed);
+            data.valid=data.attitudeValid=data.temperatureValid=false;
+#if RM_ENABLE_AHRS6
+            previousValid=false; ahrs.Reset();
+#endif
+            firstTemperature=true; failures=0;
+            deadline=tx_time_get();
+        }
+        now=BSP_GetTickMs();
+        if (ready) {
+            acc_data_t acceleration{};
+            gyro_data_t angular{};
+            bmi.ReadAccData(&acceleration);
+            const bool accOk=bmi.LastStatus()==HAL_OK;
+            bmi.ReadGyroData(&angular);
+            const bool sampleOk=accOk && bmi.LastStatus()==HAL_OK;
+            data.valid=sampleOk;
+            if (sampleOk) {
+                data.acceleration=acceleration;
+                data.angularVelocity=angular;
+                data.sampleMs=BSP_GetTickMs(); ++data.sequence; failures=0;
+#if RM_ENABLE_AHRS6
+                const float dt=previousValid ? uint32_t(data.sampleMs-previous)*0.001f :
+                                               AppConfig::ImuPeriodMs*0.001f;
+                if (!previousValid || dt>0.05f) ahrs.Reset();
+                data.attitudeValid=ahrs.Update(acceleration.x,acceleration.y,acceleration.z,
+                    angular.x,angular.y,angular.z,dt>0.05f ? AppConfig::ImuPeriodMs*0.001f : dt);
+                if (data.attitudeValid) data.attitude=ahrs.Get();
+                previous=data.sampleMs; previousValid=true;
+#endif
+            } else {
+                data.attitudeValid=false;
+#if RM_ENABLE_AHRS6
+                previousValid=false;
+#endif
+                { AppLock lock; ++app_health.imuReadErrors; }
+                if (++failures>=3) { ready=false; retry=now; setInit(InitState::Failed); }
+            }
+            if (sampleOk && (firstTemperature || uint32_t(now-temp)>=AppConfig::TemperaturePeriodMs)) {
+                float temperature=0;
+                bmi.ReadAccTemperature(&temperature);
+                data.temperatureValid=bmi.LastStatus()==HAL_OK;
+                if (data.temperatureValid) { cachedTemperature=temperature; data.temperatureMs=BSP_GetTickMs(); }
+                temp=now; firstTemperature=false;
+            }
+            data.acceleration.temperature=cachedTemperature;
+        }
+#if RM_ENABLE_IST8310
+        if (!magReady && (firstMag || uint32_t(now-magRetry)>=AppConfig::InitRetryMs)) {
+            firstMag=false; magReady=mag.Init()==HAL_OK; magRetry=BSP_GetTickMs();
+            data.magneticValid=false;
+        }
+        if (magReady && uint32_t(now-magPoll)>=AppConfig::MagneticPeriodMs) {
+            const auto status=mag.Read(&data.magneticField); magPoll=now;
+            if (status==HAL_OK) { data.magneticValid=true; data.magneticMs=BSP_GetTickMs(); }
+            else if (status!=HAL_BUSY) { data.magneticValid=false; magReady=false; magRetry=now; }
+            else if (uint32_t(now-(data.magneticValid ? data.magneticMs : magRetry))>100) {
+                data.magneticValid=false; magReady=false; magRetry=now;
+            }
+        }
+#endif
+        { AppLock lock; app_imu=data; app_health.imuDataOk=data.valid && ready; }
+        AppPulse(TaskId::Imu); // progress heartbeat continues even when sensor is disconnected
+        AppSleepUntil(deadline,AppTicks(AppConfig::ImuPeriodMs));
+    }
+}
