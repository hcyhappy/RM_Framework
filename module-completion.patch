+void tx_thread_sleep(ULONG n) { tick += n; }
+void HAL_GPIO_WritePin(GPIO_TypeDef *port, uint16_t pin, GPIO_PinState state) {
+    if (port == &ga || port == &gb) {
+        if (state == GPIO_PIN_RESET) {
+            assert(selected == -1);
+            selected = port == &ga ? 0 : 1;
+        } else
+            selected = -1;
+    }
+    if (port == &gh) {
+        ledPin = pin;
