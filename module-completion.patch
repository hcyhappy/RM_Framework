+namespace {
+bool configured(const PID &p) {
+    return std::isfinite(p.kp) && std::isfinite(p.ki) && std::isfinite(p.kd) &&
+           std::isfinite(p.maxOut) && p.maxOut > 0 && std::isfinite(p.maxIOut) && p.maxIOut >= 0 &&
