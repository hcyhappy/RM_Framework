+    while(n--) { v^=*d++; for(unsigned b=0;b<8;++b) v=(v&1)?(v>>1)^0x8408:v>>1; }
+    return v;
+}
+static uint8_t crc8(const uint8_t *d,unsigned n,uint8_t v) {
+    while(n--) { v^=*d++; for(unsigned b=0;b<8;++b) v=(v&1)?(v>>1)^0x8c:v>>1; }
+    return v;
